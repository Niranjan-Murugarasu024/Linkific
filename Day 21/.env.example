# PostgreSQL warehouse (optional; SQLite fallback is included)
WAREHOUSE_URL=postgresql+psycopg2://postgres:1234@host.docker.internal:5432/day21_warehouse
API_TIMEOUT=20
MAX_RETRIES=3

# SFTP is optional; configure only when you have a test server
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PASSWORD=
SFTP_REMOTE_PATH=
