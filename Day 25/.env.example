
# ==================================================
# DAY 24 - E-COMMERCE DATA ENGINEERING PROJECT
# PostgreSQL Configuration
# ==================================================

PGHOST=localhost
PGPORT=5432
PGDATABASE=ecommerce_practice
PGUSER=postgres
PGPASSWORD=your_password_here
PGSSLMODE=prefer


# ==================================================
# APPLICATION CONFIGURATION
# ==================================================

APP_ENV=development
LOG_LEVEL=INFO
PROJECT_NAME=day24_ecommerce_warehouse


# ==================================================
# DATA PIPELINE CONFIGURATION
# ==================================================

DATA_SOURCE=databricks_gold
DATA_FORMAT=csv

GOLD_EXPORT_DIR=data/gold_export

POSTGRES_SCHEMA=day24_gold

BATCH_SIZE=1000
MAX_RETRIES=3
RETRY_DELAY_SECONDS=5


# ==================================================
# DATA QUALITY CONFIGURATION
# ==================================================

ENABLE_PRIMARY_KEY_CHECK=true
ENABLE_FOREIGN_KEY_CHECK=true
ENABLE_NULL_CHECK=true
ENABLE_ROW_COUNT_VALIDATION=true


# ==================================================
# LOGGING CONFIGURATION
# ==================================================

LOG_DIR=logs
LOG_FILE=gold_to_postgres.log


# ==================================================
# OPTIONAL SMTP ALERT CONFIGURATION
# ==================================================

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=
ALERT_TO=
