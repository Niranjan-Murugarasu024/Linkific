Total Revenue =
SUM ( fact_sales[net_amount] )

Gross Revenue =
SUM ( fact_sales[gross_amount] )

Total Discount =
SUM ( fact_sales[discount_amount] )

Total Orders =
DISTINCTCOUNT ( fact_sales[order_id] )

Total Order Lines =
COUNTROWS ( fact_sales )

Units Sold =
SUM ( fact_sales[quantity] )

Total Customers =
DISTINCTCOUNT ( fact_sales[customer_key] )

Average Order Value =
DIVIDE ( [Total Revenue], [Total Orders] )

Average Selling Price =
DIVIDE ( [Total Revenue], [Units Sold] )

Revenue YTD =
TOTALYTD ( [Total Revenue], dim_date[full_date] )

Revenue Previous Month =
CALCULATE ( [Total Revenue], DATEADD ( dim_date[full_date], -1, MONTH ) )

Revenue MoM % =
DIVIDE ( [Total Revenue] - [Revenue Previous Month], [Revenue Previous Month] )

Revenue Previous Year =
CALCULATE ( [Total Revenue], SAMEPERIODLASTYEAR ( dim_date[full_date] ) )

Revenue YoY % =
DIVIDE ( [Total Revenue] - [Revenue Previous Year], [Revenue Previous Year] )

Completed Orders =
CALCULATE ( [Total Orders], fact_sales[status] = "COMPLETED" )

Completed Order Rate =
DIVIDE ( [Completed Orders], [Total Orders] )
